# Template for local Android release signing
# Copy this file to 'keystore.properties' (which is git-ignored) to sign release builds locally.
# DO NOT commit your real keystore or passwords to version control.

RELEASE_STORE_FILE=../hisabpro-release.keystore
RELEASE_STORE_PASSWORD=YourStorePasswordHere
RELEASE_KEY_ALIAS=hisabpro
RELEASE_KEY_PASSWORD=YourKeyPasswordHere
